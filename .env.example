CHANGEGUARD_ENVIRONMENT=development
CHANGEGUARD_DEMO_MODE=true
CHANGEGUARD_LOG_LEVEL=INFO
CHANGEGUARD_LLM_MODEL=gpt-4.1-mini
CHANGEGUARD_EMBEDDING_MODEL=text-embedding-3-small
CHANGEGUARD_PROMETHEUS_URL=http://prometheus:9090
CHANGEGUARD_ARGOCD_URL=https://argocd-server.argocd.svc
CHANGEGUARD_ARGOCD_VERIFY_TLS=true
CHANGEGUARD_KUBERNETES_NAMESPACE=changeguard-demo
